      "details": [
        {
          "title": "方向一 · 任务实测",
          "items": [
            {
              "text": "切入点：从一段长口播里，挑出一条能独立发布的短片。",
              "kind": "suggestion"
            },
            {
              "text": "大纲：交代任务 → 导入与推荐 → 挑选完整片段 → 校对并导出。",
              "kind": "suggestion"
            }
          ]
        },
        {
          "title": "方向二 · 拆条对照",
          "items": [
            {
              "text": "切入点：同一段长素材，按不同主题拆出几条各自完整的短片。",
              "kind": "suggestion"
            },
            {
              "text": "大纲：原素材结构 → 按主题看推荐 → 检查各条是否讲清问题 → 展示导出结果。",
              "kind": "suggestion"
            }
          ]
        },
        {
          "title": "方向三 · 成果倒推",
          "items": [
            {
              "text": "切入点：先看拆出的短片成果，再回到长素材了解挑选过程。",
              "kind": "suggestion"
            },
            {
              "text": "大纲：成果展示 → 回到原素材 → 演示选片与字幕校对 → 归纳选片标准。",
              "kind": "suggestion"
            }
          ]
        }
      ]
    }
