  "sources": [
    {
      "id": "product",
      "title": "随剪合作 brief（虚构）",
      "location": "第 1 节 · 产品是什么",
      "excerpt": "用户导入一段长口播，工具按主题推荐可拆出的短片段，并生成字幕。创作者选片段、校对字幕后再导出，减少反复拖动时间轴找片段的步骤。推荐片段和字幕仍需人工检查。",
      "path": "brief.md"
    },
    {
      "id": "focus",
      "title": "随剪合作 brief（虚构）",
      "location": "第 2 节 · 这次主推什么",
      "excerpt": "本次只重点讲“按主题拆条”：从长口播里找到能单独讲清一个问题的短片段。字幕是辅助演示，不要把本次内容做成字幕功能盘点。",
      "path": "brief.md"
    },
    {
      "id": "delivery",
      "title": "随剪合作 brief（虚构）",
      "location": "第 3 节 · 交付和时间",
      "excerpt": "小红书发布 1 条 60–90 秒竖屏视频，必须真人出镜。2026 年 10 月 28 日 18:00 前交脚本，2026 年 10 月 30 日发布，时间按北京时间。脚本和成片各安排 1 轮集中修改。",
      "path": "brief.md"
    },
    {
      "id": "must-show",
      "title": "随剪合作 brief（虚构）",
      "location": "第 4 节 · 必须展示",
      "excerpt": "画面必须包含：导入自己的长口播、查看推荐片段、人工校对字幕、导出结果。发布文案须注明“品牌合作”，带话题 #随剪 和 #口播剪辑。建议选择你日常真的会处理的一段素材，不要求固定口播句式。",
      "path": "brief.md"
    },
    {
      "id": "limits",
      "title": "随剪合作 brief（虚构）",
      "location": "第 5 节 · 不要这样表达",
      "excerpt": "不能出现竞品名称或界面，不说“全自动不用检查”“字幕零错误”，也不要编造耗时或效率数据。演示素材须为自有或已获授权。",
      "path": "brief.md"
    },
    {
      "id": "reference",
      "title": "随剪合作 brief（虚构）",
      "location": "第 6 节 · 参考与未定事项",
      "excerpt": "参考入口交互验收链接：https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4 。这是公开测试视频，内容与产品无关，仅用于展示“brief 中有参考视频时直接提供入口”的交互；本演示未查看该视频，不做借鉴分析。",
      "path": "brief.md"
    }
  ],
