    "video": {
      "summary": {
        "text": "从已有素材里，选一个问题做拆条实测。",
        "kind": "suggestion"
      },
      "references": [
        {
          "title": "参考视频",
          "url": "https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4",
          "status": "unviewed",
          "source_ids": [
            "reference"
          ]
        }
      ],
      "details": [
        {
          "title": "旧教程回答粉丝追问",
          "items": [
            {
              "text": "建议场景：发过手机摄影长教程的创作者。",
              "kind": "suggestion",
              "label": "达人视角"
            },
            {
              "text": "用按主题拆条找到答案，字幕作为辅助，保留人工选片与校对。",
              "kind": "suggestion",
              "source_ids": [
                "focus"
              ],
              "label": "推广功能"
            },
            {
              "text": "评论反复问“逆光怎么拍人像”。答案在旧教程里，重录费事，发长视频链接又不方便找。",
              "kind": "suggestion",
              "label": "解决痛点"
            },
            {
              "text": "不剪掉拍摄条件，也不预设工具每次都能准确推荐。",
              "kind": "suggestion",
              "label": "选题详情",
              "steps": [
                "拿出自己的完整摄影口播和一条真实提问，说明反复答疑的困扰。",
                "按问题查看推荐片段，展示为什么保留这一段，核对拍摄条件、操作和例外。",
                "校对字幕并导出，检查新观众只看短片能否理解答案。"
              ]
            }
          ],
          "preview": {
            "materials": {
              "text": "摄影长口播 + 真实评论",
              "kind": "suggestion"
            },
            "output": {
              "text": "一条逆光人像答疑短片",
              "kind": "suggestion"
            },
            "role": {
              "text": "知识 / 教程博主",
              "kind": "suggestion"
            }
          }
        },
        {
          "title": "产品讲解补齐购买条件",
          "items": [
            {
              "text": "建议场景：产品知识博主或商家创作者，有自有或已获授权的产品长口播。",
              "kind": "suggestion",
              "label": "达人视角"
            },
            {
              "text": "按主题拆条，再人工检查适用条件和限制是否保留。",
              "kind": "suggestion",
              "source_ids": [
                "focus"
              ],
              "label": "推广功能"
            },
            {
              "text": "观众只看到卖点，反复追问是否适合自己。条件埋在长介绍里，单摘一句又容易误解。",
              "kind": "suggestion",
              "label": "解决痛点"
            },
            {
              "text": "素材须获授权，演示避开竞品。",
              "kind": "suggestion",
              "label": "选题详情",
              "steps": [
                "准备自有产品的完整口播和常见咨询，选一条具体问题开场。",
                "从推荐片段中找出适用对象及限制，展示候选片段可能缺什么、人工如何补齐上下文。",
                "校对字幕、导出说明短片，确认用途与使用条件都在。"
              ]
            }
          ],
          "preview": {
            "materials": {
              "text": "自有产品介绍 + 咨询问题",
              "kind": "suggestion"
            },
            "output": {
              "text": "一条购买前说明短片",
              "kind": "suggestion"
            },
            "role": {
              "text": "产品博主 / 商家创作者",
              "kind": "suggestion"
            }
          }
        },
        {
          "title": "求职经验按问题拆成两条",
          "items": [
            {
              "text": "建议场景：已录好个人求职经验长口播的职场经验博主。",
              "kind": "suggestion",
              "label": "达人视角"
            },
            {
              "text": "按主题拆条，让两个问题各自讲完整，避免把一个观点强拆成多条。",
              "kind": "suggestion",
              "source_ids": [
                "focus"
              ],
              "label": "推广功能"
            },
            {
              "text": "投递、面试、复盘混在长口播里。按时长硬切，可能把建议与适用前提分到两条。",
              "kind": "suggestion",
              "label": "解决痛点"
            },
            {
              "text": "只展示实际选出的内容，不宣称任何长素材都能固定拆出几条。",
              "kind": "suggestion",
              "label": "选题详情",
              "steps": [
                "展示投简历与备面试两类需求，回到自己的完整求职口播找答案。",
                "分别查看推荐片段，说明选段依据，核对前提、做法和例子。",
                "校对字幕，导出两条短片，逐条检查单独观看能否理解建议。"
              ]
            }
          ],
          "preview": {
            "materials": {
              "text": "自己的完整求职经验口播",
              "kind": "suggestion"
            },
            "output": {
              "text": "投简历、备面试各一条",
              "kind": "suggestion"
            },
            "role": {
              "text": "职场经验博主",
              "kind": "suggestion"
            }
          }
        }
      ]
    }
  },
